# From @BotFather
BOT_TOKEN=
# Comma-separated chat IDs allowed to use the bot (send /start to the bot to see yours; groups are negative)
ALLOWED_CHAT_IDS=

CHECK_INTERVAL_MIN=20
JITTER_MAX_MIN=3
# Random pause between filters within one check
DELAY_MIN_SEC=10
DELAY_MAX_SEC=30
MAX_ALERTS_PER_RUN=15

# Optional HTTP proxies for OLX requests, comma-separated, e.g. http://user:pass@host:port
# If one fails or gets blocked, the bot switches to the next.
PROXY_URL=
